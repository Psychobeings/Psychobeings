PORT=8080
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/psychobeings
COOKIE_SAME_SITE=lax

# Public website and admin app origins (used for CORS and reset links).
SOURCE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Required to provision administrator accounts through POST /admin/signup.
ADMIN_BOOTSTRAP_KEY=replace_with_a_separate_random_secret

# SMTP credentials for password recovery emails.
EMAILADD=
EMAILPASS=
SENDERMAIL=

# Required by the authenticated Psycho Buddy chat endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

CONSENT_VERSION=1
